DATABASE_URL=postgres://postgres:password@localhost:5432/leo_ai_chatbot
PORT=4000

# AI provider: "stub" (default, no AI) or "groq" (free-tier hosted open-weight models)
AI_PROVIDER=stub
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# Shared secret required as "Authorization: Bearer <key>" on GET /tickets and
# PATCH /tickets/:id (used by the support dashboard). Generate a random value.
ADMIN_API_KEY=

# Resend API key (resend.com) for emailing an assignee when a ticket is
# routed to them via the dashboard. Left unset, assignment just skips the email.
RESEND_API_KEY=
